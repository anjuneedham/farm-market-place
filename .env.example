# ─────────────────────────────────────────────────────────────────────────────
# AgriLoop — environment configuration
# Copy to .env.local and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default market. Must be an ISO 3166-1 alpha-2 code present in
# src/lib/location/countries.ts with isLive: true.
NEXT_PUBLIC_DEFAULT_COUNTRY=JM

# ── Authentication (Supabase Auth) ───────────────────────────────────────────
# REQUIRED. From your Supabase project's dashboard: Project Settings → API.
# The publishable/anon key is safe to expose in the browser — every query it
# makes is enforced by Postgres Row Level Security, not by this key. NEVER
# put the service-role key in a NEXT_PUBLIC_ variable or anywhere client code
# can read it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ── Data source ──────────────────────────────────────────────────────────────
# Marketplace/listings/community data only — accounts, auth and profiles are
# always served from Supabase (above) regardless of this setting.
# "memory"  development/demo, seeded, persisted to .data/ (NOT production-safe)
# "prisma"  PostgreSQL via prisma/schema.prisma (requires DATABASE_URL)
AGRILOOP_DATA_SOURCE=memory

# Required when AGRILOOP_DATA_SOURCE=prisma
# DATABASE_URL=postgresql://user:password@localhost:5432/agriloop

# Seed demo data. Refuses to run in production unless explicitly allowed.
AGRILOOP_SEED_DEMO_DATA=true
# ALLOW_SEED_IN_PRODUCTION=false

# ── Storage (StorageService) ─────────────────────────────────────────────────
# "local"  writes to public/uploads (development only)
# "s3"     S3-compatible object storage (not implemented in the MVP)
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Email (EmailService) ─────────────────────────────────────────────────────
# "console"  logs to stdout (development)
# "none"     disabled; verification and reset emails are not sent
EMAIL_PROVIDER=console
EMAIL_FROM=AgriLoop <no-reply@example.com>
# RESEND_API_KEY=

# ── Payments (PaymentService) ────────────────────────────────────────────────
# Marketplace transactions are still arranged off-platform (buyer/seller agree
# payment directly) regardless of this setting — it only controls whether
# AgriLoop Premium's online checkout button works.
#
# "none"    Premium checkout shows an honest "not available yet" panel.
# "paypal"  PayPal Express Checkout, via the REST Orders API (no SDK dep).
PAYMENT_PROVIDER=none

# Required when PAYMENT_PROVIDER=paypal. Create an app at
# https://developer.paypal.com/dashboard/applications to get these.
# The client id is not a secret — PayPal's JS SDK requires it in the browser
# to render the buttons, so it uses the NEXT_PUBLIC_ prefix and is read by
# both the server (to request an access token) and the client (to load the
# SDK). Only the client SECRET below must stay server-only.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── AI (AIService) ───────────────────────────────────────────────────────────
# "none" for the MVP. AgriLoop AI surfaces render an explicit "not available"
# state rather than a simulated assistant.
AI_PROVIDER=none
# ANTHROPIC_API_KEY=

# ── Weather (WeatherService) ─────────────────────────────────────────────────
WEATHER_PROVIDER=none
# WEATHER_API_KEY=
